  ACTIVE
  FROZEN
  REJECTED
}

enum LedgerEntryType {
  JOB_EARNING
  INCENTIVE
  BONUS
  PENALTY
  ADVANCE
  ADJUSTMENT
  COMMISSION
  WITHDRAWAL
  GST // reserved — no logic yet, per spec's "(Future)"
  TDS // reserved — no logic yet, per spec's "(Future)"
  LEAD_COST // Vendor Wallet: debited on job accept, credited back on refund — see PartnerLedgerService
  HOLD // Vendor Wallet: debit posted when money moves into ANY PartnerHold (warranty/admin-manual)
  HOLD_RELEASE // Vendor Wallet: credit posted when a PartnerHold is released (auto or admin)
