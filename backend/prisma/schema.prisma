model WalletTransaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  reason          TransactionReason
  amount          Decimal           @db.Decimal(10, 2)
  balanceAfter    Decimal           @db.Decimal(10, 2)
  orderId         String?
  // Set when this credit/debit was a refund decision — links back to the RefundRequest
  // audit trail (which admin approved it, what evidence backed it, etc.)
  refundRequestId String?
  // Admin userId who approved this transaction, when it's an admin-driven adjustment
  // or a refund-to-wallet credit rather than a customer-initiated action.
  approvedBy      String?
  notes           String?
  createdAt       DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([refundRequestId])
}

model MembershipPlan {
  id                String         @id @default(cuid())
  tier              MembershipTier @unique
  name              String
  description       String?
  priceMonthly      Decimal        @db.Decimal(10, 2)
  priceYearly       Decimal        @db.Decimal(10, 2)
  discountPercent   Int            @default(0)
  freeServicesCount Int            @default(0)
  prioritySupport   Boolean        @default(false)
  freeDelivery      Boolean        @default(false)
  exclusiveDeals    Boolean        @default(false)
