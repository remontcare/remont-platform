// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATION ENGINE — shared across every portal (customer/partner/seller/
// admin/CRM/AMC/...), independent of business modules. See notification-engine
// module: business code emits domain events (EventEmitter2), never imports
// this directly. `Notification` above stays the user-facing inbox row; these
// models are the technical per-channel/per-device delivery plumbing behind it,
// mirroring how WhatsappLog is already a separate technical log from the
// user-facing row it supports.
// ═══════════════════════════════════════════════════════════════════════════

model DeviceToken {
  id               String         @id @default(cuid())
  userId           String
  token            String         @unique
  platform         DevicePlatform
  userAgent        String?
  isActive         Boolean        @default(true)
  subscribedTopics String[]       @default([])
  lastSeenAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, isActive])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  deviceTokenId  String?
  status         NotificationDeliveryStatus @default(QUEUED)
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(3)
  nextAttemptAt  DateTime?
  lastError      String?
  sentAt         DateTime?
  ackedAt        DateTime? // client-reported delivered/opened/acted-on — stops ring retries
  // Denormalized off the parent Notification purely so retry-sweep.service.ts's cron
  // (which only loads NotificationDelivery rows) can emit a meaningful 'notification.exhausted'
  // event without a second query per row — Notification itself stays the simple,
  // stable user-facing inbox shape every portal's bell icon already reads.
  type           String?
  data           Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id])
  deviceToken  DeviceToken? @relation(fields: [deviceTokenId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([notificationId])
}

model ScheduledNotification {
  id           String                @id @default(cuid())
  userId       String? // null = broadcast/topic send
  topic        String?
  title        String
  body         String
  data         Json?
  channels     NotificationChannel[]
  scheduledFor DateTime
  status       ScheduledStatus       @default(PENDING)
  createdAt    DateTime              @default(now())
  sentAt       DateTime?

  @@index([status, scheduledFor])
}

