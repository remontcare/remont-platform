  customerName   String
  customerPhone  String
  customerEmail  String?
  customerUserId String? // linked once converted to registered user
  cityName       String?

  // Lead source & status
  source            LeadSource
  status            LeadStatus @default(NEW)
  serviceInterested String?
  estimatedValue    Decimal?   @db.Decimal(10, 2)
  // Customer-attached reference photo (e.g. current room/site condition for a
  // renovation/construction quotation request) — optional, set via the public
  // lead-photo upload endpoint. A real field rather than burying the URL in
  // `notes` so the admin console can render it as an actual thumbnail.
  photoUrl          String?

  // Tracking
  assignedAgentId  String?
  notes            String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  convertedAt      DateTime?
  convertedOrderId String?
  lostReason       String?

  // Source tracking
  aiSessionId String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User?         @relation("LeadCustomer", fields: [customerUserId], references: [id])
  agent      User?         @relation("LeadAgent", fields: [assignedAgentId], references: [id])
  activities CrmActivity[]
  orders     Order[]

  @@index([status])
  @@index([assignedAgentId])
  @@index([customerPhone])
  @@index([createdAt])
