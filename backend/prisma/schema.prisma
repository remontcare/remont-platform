// Which pipeline a service's orders route through when confirmed — see
// resolveServiceRouting() in common/index.ts.
enum FulfillmentType {
  DIRECT_PARTNER // auto-match a vendor (in-house first, then partner) — current default behaviour
  ADMIN_TEAM // smaller admin-handled services — no auto vendor match, goes to the admin queue
  PROJECT // project-scale work — never auto-assigned, always goes to the admin queue
}

// In-house Remont staff vs an external partner vendor — used to prioritize in-house
// staff first when auto-routing a DIRECT_PARTNER service.
enum StaffType {
  IN_HOUSE
  PARTNER
}

// Billing/GST classification (see backend/src/common/billing-engine.ts) — which of the
// three revenue models a given Order falls under. Named distinctly from the existing
// `TransactionType` enum (CREDIT/DEBIT, used by wallet ledger entries) to avoid a
// collision. Snapshotted once onto Order.billingTransactionType at confirmation time
// (derived from Order.type + the assigned vendor's StaffType) and never re-derived, so a
// vendor reassignment or later staffType edit can't retroactively change how a past
// order was invoiced.
enum BillingTransactionType {
  PLATFORM_SERVICE // partner-fulfilled service (Ola/Urban Company model) — Remont invoices its own fee only
  DIRECT_PROJECT // Remont's own in-house team fulfills the service — Remont invoices the full value
  MARKETPLACE_PRODUCT // product sold via a marketplace seller — seller invoices the customer, Remont invoices its commission to the seller
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  PENDING_APPROVAL
  ACTIVE
  FROZEN
  REJECTED
}

enum LedgerEntryType {
  JOB_EARNING
  INCENTIVE
  BONUS
  PENALTY
  ADVANCE
  ADJUSTMENT
  COMMISSION
  WITHDRAWAL
  GST // reserved — no logic yet, per spec's "(Future)"
  TDS // reserved — no logic yet, per spec's "(Future)"
  LEAD_COST // Vendor Wallet: debited on job accept, credited back on refund — see PartnerLedgerService
  HOLD // Vendor Wallet: debit posted when money moves into ANY PartnerHold (warranty/admin-manual)
  HOLD_RELEASE // Vendor Wallet: credit posted when a PartnerHold is released (auto or admin)
  TOP_UP // Vendor Wallet: partner-initiated Razorpay top-up, credited only after server-side payment verification — see WithdrawalService.confirmVendorTopup()
  COD_COLLECTION // Vendor Wallet: debit posted when a vendor collects cash/UPI/card directly from a customer on Remont's behalf — see OrdersService.collectBalance()/collectCod(). The job's own JOB_EARNING credit already reflects the vendor's rightful payout; this debit nets out the cash they're physically holding so pendingPayout never double-counts money the vendor already has in hand.
}

