// ─── REFUNDS & SETTLEMENT ENUMS ───
// Full approval pipeline per business rule: customer request -> evidence -> partner
// response -> Remont support review -> admin final approval -> processed. No refund
// is ever automatic; only ADMIN/SUPER_ADMIN can transition into APPROVED/PARTIALLY_APPROVED/REJECTED.
enum RefundRequestStatus {
  REQUESTED
  PARTNER_RESPONDED
  UNDER_REVIEW
  ESCALATED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PROCESSED
}

// Default is WALLET_CREDIT per business rule — gateway refund is the exception path
// (legal requirement, wallet unusable, or explicit admin exception).
enum RefundDecisionMode {
  WALLET_CREDIT
  PARTIAL_WALLET_PARTIAL_GATEWAY
  GATEWAY_REFUND
  FREE_REWORK
  DISCOUNT_COUPON
  NO_REFUND
}

// Manual record-keeping only — no payout gateway is configured, so recording a
// settlement here does not itself move money; it documents that admin already paid
// the partner via one of these modes and reduces ServiceVendor.pendingPayout.
enum SettlementMode {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String
  avatarUrl     String?
  role          UserRole  @default(CUSTOMER)
  language      Language  @default(EN)
  isVerified    Boolean   @default(false)
  isBlocked     Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpLastSentAt DateTime?
  walletBalance Decimal   @default(0) @db.Decimal(10, 2)
  referralCode  String?   @unique
  referredById  String?
  cityId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  addresses              Address[]
  membership             UserMembership?
  orders                 Order[]
  masterOrders           MasterOrder[]
  walletTransactions     WalletTransaction[]
  reviews                Review[]
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  serviceVendor          ServiceVendor?
  productVendor          ProductVendor?
  deliveryPartner        DeliveryPartner?
  corporateMembership    CorporateMember?
  aiSessions             AiSession[]
  city                   City?               @relation(fields: [cityId], references: [id])
  leadsAssigned          Lead[]              @relation("LeadAgent")
  leadsCreated           Lead[]              @relation("LeadCustomer")
  crmActivities          CrmActivity[]
  amcSubscriptions       AmcSubscription[]
  deleteRequestsMade     DeleteRequest[]     @relation("DeleteRequester")
  deleteRequestsReviewed DeleteRequest[]     @relation("DeleteReviewer")
  loginHistory           LoginHistory[]
  refreshSessions        RefreshSession[]
  auditLogs              AuditLog[]

  @@index([phone])
  @@index([role])
  @@index([cityId])
}

model Address {
  id               String    @id @default(cuid())
  userId           String
  label            String    @default("Home")
  fullAddress      String
  area             String    @default("") // locality / suburb
  landmark         String    @default("")
  city             String
  state            String
  country          String    @default("India")
  pincode          String
  latitude         Float     @default(0)
  longitude        Float     @default(0)
  accuracy         Float? // GPS accuracy in metres
  locationSource   String    @default("MANUAL") // GPS | MANUAL
  capturedAt       DateTime? // when GPS was captured
  placeId          String? // Google Place ID — unused until Places Autocomplete is enabled
  formattedAddress String? // Google-formatted address — unused until Places Autocomplete is enabled
  isDefault        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  masterOrders MasterOrder[]

  @@index([userId])
  @@index([locationSource])
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTH INFRASTRUCTURE — login history, refresh-token sessions, audit trail
// ═══════════════════════════════════════════════════════════════════════════

model LoginHistory {
  id            String     @id @default(cuid())
  userId        String?
  phone         String
  role          UserRole?
  platform      Platform   @default(WEB)
  action        AuthAction
  success       Boolean
  failureReason String?
  ip            String?
  userAgent     String?
  createdAt     DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phone])
  @@index([createdAt])
}

// Backs refresh-token rotation + "logout this device" / "logout all devices".
// tokenHash is a sha256 of the raw refresh JWT — never store the raw token.
model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenId    String    @unique // the JWT's jti claim
  tokenHash  String
  platform   Platform  @default(WEB)
  deviceInfo String?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
}

// Scoped to RBAC-relevant admin actions (role grants, blocks, delete-request
// decisions) — not a general-purpose activity log for the whole platform.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  UserRole
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// CITY (master) — drives city-wise availability & pricing
// ═══════════════════════════════════════════════════════════════════════════

model City {
  id            String    @id @default(cuid())
  name          String    @unique
  state         String
  latitude      Float
  longitude     Float
  pincodes      String[]
  isActive      Boolean   @default(true)
  activeVendors Int       @default(0)
  launchDate    DateTime?

  // Which service categories are active in this city
  activeServiceKeys String[]

  // City-wise multiplier on base prices (0.8 = 20% cheaper, 1.2 = 20% costlier)
  priceMultiplier Decimal @default(1.0) @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  services        CityService[]
  products        CityProduct[]
  commissionRules CommissionRule[]
  pricingTiers    ServicePricing[]
}

// ═══════════════════════════════════════════════════════════════════════════
// COMMISSION RULES (Task 9) — category-level, service-level, and city-wise
// platform commission. See resolveCommission() in common/index.ts for the
// priority + fallback resolution logic (service overrides category; category
// applies to every service in it by default; nothing matched = 0 or a
// SiteSetting default).
// ═══════════════════════════════════════════════════════════════════════════

enum CommissionScope {
  CATEGORY
  SERVICE
}

enum CommissionType {
  PERCENTAGE
  FLAT
  SLAB
}

model CommissionRule {
  id         String          @id @default(cuid())
  scope      CommissionScope
  categoryId String? // required when scope=CATEGORY
  serviceId  String? // required when scope=SERVICE
  cityId     String? // null = applies to all cities

  commissionType CommissionType
  // Percentage (0-100) or flat ₹ amount — ignored when commissionType=SLAB, where
  // slabJson is the source of truth instead.
  value          Decimal        @default(0) @db.Decimal(10, 2)
  slabJson       Json? // tiered rules by price range, e.g. [{min,max,type:"PERCENTAGE"|"FLAT",value}]

  // Higher priority wins when more than one rule matches at the same specificity level.
  // A `stackable` rule ADDS its own amount on top of whichever single rule already won —
  // opt-in per rule so stacking never happens by surprise.
  priority  Int       @default(0)
  stackable Boolean   @default(false)
  isActive  Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  service  Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city     City?            @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([categoryId, cityId])
  @@index([serviceId, cityId])
}

// Phase 7 — marketplace fee rules for PRODUCT sellers (commission/marketing/gateway/future
// fee types). A new sibling model rather than an extension of CommissionRule above: that
// model's categoryId/serviceId are typed FKs to ServiceCategory/Service specifically, so
// growing it for products would make every row polymorphic/sparse and force scope-aware
// branching into resolveCommission(), its admin CRUD, and its UI for no benefit this
// dedicated table doesn't already give more cleanly. `feeType` is what lets ALL current and
// future non-delivery marketplace fees share one table/resolver/admin surface — adding a
// new kind of fee later is just a new ProductFeeType enum value, never a schema redesign.
enum ProductFeeType {
  COMMISSION
  MARKETING
  GATEWAY
  OTHER
}

enum ProductFeeScope {
  PRODUCT_CATEGORY
  PRODUCT
}

model ProductFeeRule {
  id                String          @id @default(cuid())
  feeType           ProductFeeType
  scope             ProductFeeScope
  productCategoryId String? // required when scope=PRODUCT_CATEGORY
  productId         String? // required when scope=PRODUCT

  commissionType CommissionType // reused as-is: PERCENTAGE | FLAT | SLAB
  value          Decimal        @default(0) @db.Decimal(10, 2)
  slabJson       Json?

  priority  Int       @default(0)
  stackable Boolean   @default(false)
  isActive  Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productCategory ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([feeType, productCategoryId])
  @@index([feeType, productId])
}

// City-wise service pricing & availability override
model CityService {
  id                String   @id @default(cuid())
  cityId            String
  serviceId         String
  isActive          Boolean  @default(true)
  customPrice       Decimal? @db.Decimal(10, 2)
  customDiscountPct Int      @default(0)

  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cityId, serviceId])
  @@index([cityId, isActive])
}

// City-wise product availability
model CityProduct {
  id          String   @id @default(cuid())
  cityId      String
  productId   String
  isActive    Boolean  @default(true)
  stock       Int      @default(0)
  customPrice Decimal? @db.Decimal(10, 2)

  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cityId, productId])
  @@index([cityId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// SERVICE CATALOG
// ═══════════════════════════════════════════════════════════════════════════

model ServiceCategory {
  id          String   @id @default(cuid())
  key         String   @unique
  slug        String?  @unique
  name        String
  icon        String
  logoUrl     String?
  imageUrl    String?
  videoUrl    String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isPremium   Boolean  @default(false)
  seoTitle    String?
  seoDesc     String?
  seoKeywords String[]

  // Vendor Wallet: Warranty Hold override for jobs in this category. Null means "use the
  // global wallet_warranty_days / wallet_warranty_hold_percent SiteSetting default" — see
  // PartnerLedgerService.getWarrantyDefaults().
  warrantyDays        Int?
  warrantyHoldPercent Float?

  services        Service[]
  subCategories   SubCategory[]
  commissionRules CommissionRule[]
  priceModifiers  ServicePriceModifier[]
}

model SubCategory {
  id          String  @id @default(cuid())
  categoryId  String
  key         String
  slug        String? @unique
  name        String
  icon        String?
  imageUrl    String?
  videoUrl    String?
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  services Service[]

  @@unique([categoryId, key])
  @@index([categoryId])
}

model Service {
  id              String          @id @default(cuid())
  categoryId      String
  subCategoryId   String?
  name            String
  slug            String          @unique
  description     String?
  unit            String          @default("per visit")
  inclusions      String[]
  exclusions      String[]
  basePrice       Decimal         @db.Decimal(10, 2)
  originalPrice   Decimal?        @db.Decimal(10, 2)
  durationMinutes Int             @default(60)
  requiredSkills  String[]
  // Which pipeline this service's orders route through when confirmed — see
  // resolveServiceRouting() in common/index.ts (Task 8).
  fulfillmentType FulfillmentType @default(DIRECT_PARTNER)
  imageUrl        String?
  images          String[]
  videoUrl        String?
  faqJson         Json?
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String[]
  isActive        Boolean         @default(true)
  isPopular       Boolean         @default(false)
  isPremium       Boolean         @default(false)
  paymentMode     ServicePaymentMode @default(ANY)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // ── Estimate Engine (Interior / Renovation / Architecture / future
  //    services) — see backend/src/modules/estimates/estimate-engine.ts.
  //    All nullable/defaulted so this is a purely additive change; existing
  //    services keep working exactly as before with no data migration needed. ──
  serviceType        ServiceDeliveryType @default(ONSITE)
  pricingType         PricingType         @default(FIXED)
  offerPrice          Decimal?            @db.Decimal(10, 2) // time-bound promo price; wins over basePrice when set
  consultationFee     Decimal?            @db.Decimal(10, 2)
  siteVisitFee        Decimal?            @db.Decimal(10, 2)
  labourCost          Decimal?            @db.Decimal(10, 2)
  materialCost        Decimal?            @db.Decimal(10, 2)
  perSqftRate         Decimal?            @db.Decimal(10, 2) // used when pricingType = PER_SQFT
  gstOverridePercent  Decimal?            @db.Decimal(5, 2)  // null = resolve from TaxConfig
  // SAC code for this service's invoice line items — falls back to the matching
  // TaxConfig row's hsnCode when unset (see resolveHsnSac() in billing-engine.ts).
  hsnSac              String?
  timelineMinDays     Int?
  timelineMaxDays     Int?

  category        ServiceCategory        @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory?           @relation(fields: [subCategoryId], references: [id])
  orders          Order[]
  orderServiceItems OrderServiceItem[]
  cityServices    CityService[]
  reviews         Review[]
  commissionRules CommissionRule[]
  priceModifiers  ServicePriceModifier[]
  estimates       Estimate[]
  pricingTiers    ServicePricing[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive, isPopular])
}

enum PricingTier {
  STANDARD
  PREMIUM
  ECONOMY
}

// Admin-managed per-service, per-city, per-tier price sheet — the Admin → Service
// Pricing screen. cityId null = "All Cities" (a city-agnostic tier default).
// Only the STANDARD tier currently affects what a customer actually pays
// (CitiesService.getServicePrice) — there is no booking-flow UI yet for a customer
// to choose PREMIUM/ECONOMY, so those rows are admin-visible/manageable but inert
// for pricing until that selection exists. See getServicePrice()'s doc comment for
// the full precedence chain against the pre-existing CityService.customPrice.
model ServicePricing {
  id              String      @id @default(cuid())
  serviceId       String
  cityId          String?
  tier            PricingTier @default(STANDARD)
  basePrice       Decimal     @db.Decimal(10, 2)
  discountedPrice Decimal?    @db.Decimal(10, 2)
  duration        Int? // informational per-tier duration override; not read by scheduling
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city    City?   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([cityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ESTIMATE ENGINE — reusable server-side pricing/estimate calculator for
// Interior, Renovation, Architecture, and future service categories. See
// backend/src/modules/estimates/estimate-engine.ts for the calculation logic;
// nothing here is consumed by the frontend directly.
// ═══════════════════════════════════════════════════════════════════════════

enum ServiceDeliveryType {
  DIGITAL // PAN-India/worldwide, no city restriction ever applied
  ONSITE // requires a professional physically present — city-gated
  HYBRID // has both a remote and an on-site component — gated like ONSITE today
}

enum PricingType {
  FIXED // basePrice/offerPrice is the final price
  STARTING_FROM // basePrice/offerPrice is the low end of a range (see estimate_starting_from_spread_pct)
  QUOTATION // no computed price — final cost confirmed after consultation/site visit
  PER_SQFT // computed from perSqftRate * customer-supplied sqft
}

// Admin-configurable, per-service payment-method eligibility — the single source of
// truth read by both the website checkout and the Flutter app, and re-checked
// server-side in OrdersService.switchToCod()/retryPayment(), GuestBookingService.book()
// and MasterOrdersService.checkout()/switchToCod() so a stale client can never bypass it.
enum ServicePaymentMode {
  ANY // Online AND Cash on Delivery — customer's choice (default)
  ONLINE_ONLY // Cash on Delivery is not offered for this service
  COD_ONLY // Online payment is not offered for this service
}

// Admin-configurable multiplier applied on top of a service's price for a given
// customer selection (e.g. group="size", label="Large", multiplier=1.4). A
// serviceId-scoped row overrides a categoryId-scoped row for the same group —
// same override pattern as CommissionRule (service beats category).
model ServicePriceModifier {
  id         String   @id @default(cuid())
  serviceId  String?
  categoryId String?
  group      String // e.g. "size", "finish" — options within a group are mutually exclusive in the UI
  label      String // e.g. "Large", "Luxury"
  multiplier Decimal  @default(1.0) @db.Decimal(4, 2)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  service  Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([serviceId, group])
  @@index([categoryId, group])
}

// One row per estimate request — audit trail, lead follow-up context, and
// analytics. cityId/customerId/leadId are intentionally plain (unrelated)
// scalar columns rather than Prisma relations, so this migration never has to
// touch the City/User/Lead models.
model Estimate {
  id         String  @id @default(cuid())
  serviceId  String
  cityId     String?
  customerId String?
  leadId     String?

  inputsJson         Json
  estimatedLow        Decimal? @db.Decimal(10, 2)
  estimatedHigh        Decimal? @db.Decimal(10, 2)
  breakdownJson       Json
  gstPercent          Decimal  @db.Decimal(5, 2)
  gstAmount           Decimal  @db.Decimal(10, 2)
  finalPayableAmount  Decimal  @db.Decimal(10, 2)
  timelineMinDays     Int?
  timelineMaxDays     Int?
  bookingEligible     Boolean
  eligibilityReason   String
  eligibilityMessage  String?
  convertedOrderId    String? // set later if this estimate turns into a real Order

  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([cityId])
  @@index([leadId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// PRODUCT CATALOG
// ═══════════════════════════════════════════════════════════════════════════

model ProductCategory {
  id        String  @id @default(cuid())
  key       String  @unique
  name      String
  icon      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products        Product[]
  productFeeRules ProductFeeRule[]
  taxConfigs      TaxConfig[]
}

model Product {
  id              String              @id @default(cuid())
  vendorId        String?
  categoryId      String
  name            String
  slug            String              @unique
  sku             String              @unique
  brand           String?
  description     String?
  aiGeneratedDesc String?
  unit            String              @default("piece")
  price           Decimal             @db.Decimal(10, 2)
  mrp             Decimal?            @db.Decimal(10, 2)
  // HSN code for this product's invoice line items — falls back to the matching
  // TaxConfig row's hsnCode when unset (see resolveHsnSac() in billing-engine.ts).
  hsnSac          String?
  // Per-product GST rate override — mirrors Service.gstOverridePercent. Different
  // products legitimately carry different GST slabs even within the same catalog
  // (e.g. 12% vs 18% vs 28%); null means resolve by HSN/SAC match against TaxConfig,
  // then the scope's blanket default (see buildTaxRateResolver in common/index.ts).
  gstOverridePercent Decimal? @db.Decimal(5, 2)
  // Phase 8 — per-product override of GST price treatment. Null = resolve via the same
  // TaxConfig chain gstOverridePercent already falls back through (HSN match → category
  // default → blanket default → GST_EXCLUSIVE). Mirrors gstOverridePercent's exact
  // null-fallback convention.
  gstInclusive    Boolean?
  stock           Int                 @default(0)
  images          String[]
  aiEnhancedImgs  String[]
  specifications  Json?
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String[]
  isActive        Boolean             @default(true)
  views           Int                 @default(0)
  rating          Float               @default(0)
  reviewCount     Int                 @default(0)
  coverageType    ProductCoverageType @default(PAN_INDIA)
  // Compliance/spec fields — fillable manually or via the paid "Live Web Search" AI
  // enrichment (see AiFeatureUsage / ai-enrichment.module.ts). All optional so basic
  // product creation never requires them.
  manufacturer    String?
  modelNumber     String?
  warranty        String?
  countryOfOrigin String?
  weightKg        Decimal?            @db.Decimal(8, 3)
  lengthCm        Decimal?            @db.Decimal(8, 2)
  widthCm         Decimal?            @db.Decimal(8, 2)
  heightCm        Decimal?            @db.Decimal(8, 2)

  // Phase 6 — per-product after-sales policy, admin-configurable (frontend/admin/products.html
  // "Policy" tab). All defaulted so every pre-existing product keeps today's implicit
  // "always returnable/replaceable, no warranty" behaviour with zero migration/backfill.
  // Read by SupportPolicyEngine (support.module.ts) to gate which Help & Support options a
  // customer sees and whether a return/replacement/warranty request is actually honoured.
  returnable             Boolean  @default(true)
  returnWindowDays       Int? // null = fall back to SiteSetting support_product_return_window_days
  returnConditions       String?
  replaceable            Boolean  @default(true)
  replacementWindowDays  Int? // null = falls back to returnWindowDays
  replacementConditions  String?
  warrantyAvailable      Boolean  @default(false)
  warrantyType           String? // 'MANUFACTURER' | 'SELLER' | 'BRAND' — plain string, same convention as SupportCase.requestedRemedy
  warrantyDurationMonths Int?
  warrantyInstructions   String?
  evidencePhotoRequired  Boolean  @default(true)
  evidenceVideoRequired  Boolean  @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vendor            ProductVendor?      @relation(fields: [vendorId], references: [id])
  category          ProductCategory     @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  cityProducts      CityProduct[]
  reviews           Review[]
  inventory         IssuedInventory[]
  zones             ProductZone[]
  locationInventory LocationInventory[]
  aiFeatureUsages   AiFeatureUsage[]
  warrantyCases     WarrantyCase[]
  productFeeRules   ProductFeeRule[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([isActive])
  @@index([coverageType])
}

enum AiFeatureType {
  WEB_SEARCH
  IMAGE_SEARCH
  IMAGE_GENERATION
}

enum AiFeatureStatus {
  SUCCESS
  FAILED
  REFUNDED
}

// Audit trail for paid, wallet-gated seller AI operations on a product (live web search
// enrichment, real-photo image search, AI image generation). One row per feature per
// execute() call — see ai-enrichment.module.ts. Charging happens via the existing generic
// WalletService.debit()/credit() (reason AI_FEATURE_CHARGE / REFUND) against the seller's
// own User.walletBalance; this table is the feature-specific record layered on top of that
// generic wallet ledger (walletTransactionId links the two).
model AiFeatureUsage {
  id                  String          @id @default(cuid())
  sellerId            String
  productId           String?
  feature             AiFeatureType
  costCharged         Decimal         @db.Decimal(10, 2)
  walletTransactionId String?
  status              AiFeatureStatus
  resultJson          Json?
  errorMessage        String?
  createdAt           DateTime        @default(now())

  seller  ProductVendor @relation(fields: [sellerId], references: [id])
  product Product?      @relation(fields: [productId], references: [id])

  @@index([sellerId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CATALOG RELATIONS — the Service ↔ Product recommendation/cross-sell engine.
// One generic, directional edge per relationship (Product/Service can each be
// on either end) instead of four separate join tables — mirrors how this
// schema already uses plain arrays for loosely-structured catalog data
// (Service.inclusions/exclusions, Product.seoKeywords) rather than rigid
// per-case tables. fromId/toId are plain strings, not @relation FKs, because
// each can point at either a Product or a Service row (Prisma has no native
// polymorphic association) — validity is enforced application-side in
// CatalogRelationsService, not by the database.
//
// Bidirectionality without duplicate rows: a single (Service "AC
// Installation" → REQUIRED → Product "Outdoor Unit Stand") row answers BOTH
// "what does AC Installation need?" (forward query: fromType/fromId) AND
// "what service does the Outdoor Unit Stand need?" (reverse query:
// toType/toId) — the read side queries both directions and merges.
// ═══════════════════════════════════════════════════════════════════════════
enum CatalogEntityType {
  PRODUCT
  SERVICE
}

// Priority order the read API sorts by (REQUIRED first, RELATED last) —
// matches the "Smart Priority" ranking the recommendation UI needs.
enum CatalogRelationType {
  REQUIRED // normally needed to complete the other side (AC Installation → Copper Pipe)
  COMPATIBLE // fits/works with (Outdoor Unit Stand compatible with a specific AC model)
  INSTALLATION_SERVICE // the service that installs/sets up this product (AC → AC Installation)
  FREQUENTLY_BOUGHT_TOGETHER
  RECOMMENDED // convenience/AOV add-on, not required (AC → AC Cover)
  RELATED // loosely related, lowest priority (Tap → Plumbing Service)
}

model CatalogRelation {
  id           String              @id @default(cuid())
  fromType     CatalogEntityType
  fromId       String
  toType       CatalogEntityType
  toId         String
  relationType CatalogRelationType @default(RECOMMENDED)
  sortOrder    Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  createdBy    String? // admin User.id, for audit only — no FK (admin users can be deleted)

  @@unique([fromType, fromId, toType, toId, relationType])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// Pincode/area-level coverage — schema exists now per the "future ready" requirement,
// but nothing in products.module.ts's filtering logic reads this yet. When zone-level
// enforcement is actually built, ProductCoverageType.ZONES should start consulting this
// table instead of falling back to CityProduct like it does today.
model ProductZone {
  id        String   @id @default(cuid())
  productId String
  pincode   String?
  areaName  String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════════════
// VENDORS
// ═══════════════════════════════════════════════════════════════════════════

model ServiceVendor {
  id                 String       @id @default(cuid())
  userId             String       @unique
  fullName           String
  businessName       String?
  photoUrl           String?
  skills             String[]
  serviceRadius      Int          @default(10)
  baseCity           String
  // In-house Remont staff vs an external partner — routing prioritizes IN_HOUSE first
  // for DIRECT_PARTNER services (Task 8). Defaults to PARTNER so every existing vendor
  // keeps today's behaviour with zero migration needed.
  staffType          StaffType    @default(PARTNER)
  status             VendorStatus @default(PENDING_VERIFICATION)
  isOnline           Boolean      @default(false)
  isVipPro           Boolean      @default(false)
  preferredLanguage  Language     @default(EN)
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?
  rating             Float        @default(0)
  completedJobs      Int          @default(0)
  totalEarnings      Decimal      @default(0) @db.Decimal(12, 2)
  pendingPayout      Decimal      @default(0) @db.Decimal(12, 2)
  rejectionReason    String?
  createdAt          DateTime     @default(now())
  // Carried over from PartnerRegistration.experienceYears at approval time — was captured
  // during onboarding but never copied onto the live vendor profile, so it was unusable
  // from anywhere except the pre-approval registration record. Free text (e.g. "5 years"),
  // matching the source field's own type.
  experienceYears    String?

  // Vendor Wallet — a withdrawal floor, not a separate pool of money: availableBalance()
  // subtracts this from the vendor's ledger balance before anything is withdrawable. Set
  // from the wallet_base_hold_amount SiteSetting default on activation; admin-editable per
  // vendor afterward via PATCH /admin/vendors/:id/base-hold.
  baseHoldAmount Decimal @default(0) @db.Decimal(12, 2)

  // GST registration for this partner — most technician/individual partners are below
  // the GST threshold and have none, so this is optional. Presence of a value IS the
  // "registered" signal (no separate boolean, so the two can never disagree); the
  // billing engine only ever produces a GST breakup on a partner's own settlement amount
  // when this is set, otherwise the amount stays a plain, non-GST pass-through line.
  gstin String?

  // ── Phase 2: Agency Partner Management ──────────────────────────────
  // No separate Agency entity — an agency owner is just a ServiceVendor with
  // isAgencyOwner:true; a team member is a ServiceVendor with agencyOwnerId
  // pointing at the owner's own id. Individuals and agency owners both have
  // agencyOwnerId:null (both may request withdrawals); members never can.
  isAgencyOwner Boolean       @default(false)
  agencyOwnerId String?
  agencyStatus  AgencyStatus?
  memberStatus  MemberStatus?

  // Bank details — never written by the vendor directly (see VendorBankUpdateRequest);
  // an approved request is the only path that lands values here.
  bankAccountHolder String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?

  user               User                       @relation(fields: [userId], references: [id])
  documents          VendorDocument[]
  orders             Order[]
  issuedInventory    IssuedInventory[]
  reviews            Review[]
  extraWorks         ExtraWorkItem[]
  settlements        PartnerSettlement[]
  agencyOwner        ServiceVendor?             @relation("AgencyMembers", fields: [agencyOwnerId], references: [id])
  members            ServiceVendor[]            @relation("AgencyMembers")
  ledgerEntries      PartnerLedgerEntry[]
  withdrawalRequests WithdrawalRequest[]
  attendance         VendorAttendance[]
  holds              PartnerHold[]
  bankUpdateRequests VendorBankUpdateRequest[]
  cityUpdateRequests VendorCityUpdateRequest[]

  @@index([status, isOnline])
  @@index([baseCity])
  @@index([agencyOwnerId])
  // Scale fix: DispatchService.dispatch()'s GPS-radius candidate query previously had no
  // geographic filter at the DB level at all — it pulled up to 50 online+matching-skill
  // vendors NATIONWIDE with no ordering, then filtered by distance in-app. Once the online
  // vendor pool across all cities exceeds 50, the actual nearest vendor for a given order
  // could simply never be among the 50 rows fetched. This composite index makes the new
  // bounding-box prefilter (see MAX_DISPATCH_RADIUS_KM in common/index.ts) an index range
  // scan instead of a sequential scan as the vendor table grows into the thousands.
  @@index([currentLatitude, currentLongitude])
  // Every dispatch/routing/eligibility check filters ServiceVendor.skills with `has`/
  // `hasSome` — a GIN index is what actually lets Postgres use an index for Postgres array
  // containment operators (a plain B-tree index cannot); without it, this check degrades to
  // a sequential scan of every ACTIVE+isOnline vendor as the table grows.
  @@index([skills], type: Gin)
}

model VendorBankUpdateRequest {
  id            String    @id @default(cuid())
  vendorId      String
  accountName   String
  accountNumber String
  ifsc          String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])
  @@index([vendorId])
}

// Same request/approve shape as VendorBankUpdateRequest, applied to baseCity — a vendor's
// approved city must never change unmoderated (it directly drives job-assignment
// eligibility), so a change goes through this queue instead of being written straight to
// ServiceVendor.baseCity. Only ServiceVendorsService.register()'s initial CREATE still
// sets baseCity directly (first-time registration, nothing to "correct" yet); its UPDATE
// path no longer touches baseCity at all once a vendor is ACTIVE.
model VendorCityUpdateRequest {
  id            String    @id @default(cuid())
  vendorId      String
  requestedCity String
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])
  @@index([vendorId])
  @@index([status])
}

model VendorDocument {
  id         String   @id @default(cuid())
  vendorId   String
  type       String
  url        String
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model ProductVendor {
  id                String       @id @default(cuid())
  userId            String       @unique
  businessName      String
  ownerName         String?
  businessType      String?
  gstNumber         String?
  panNumber         String?
  aadhaarNumber     String?
  cin               String?
  msmeNumber        String?
  alternatePhone    String?
  whatsappNumber    String?
  email             String?
  city              String?
  address           String? // registered address
  // Registered GST state — needed as the place-of-supply when Remont invoices its own
  // marketplace commission to this seller (recipient of that invoice is the seller, not
  // the customer, so the customer's delivery state doesn't apply here). Separate from
  // `city`/`address`, which are free text and not reliably parseable into a state.
  state             String?
  officeAddress     String?
  warehouseAddress  String?
  pickupAddress     String? // legacy free-text field, predates the PickupLocation model below — kept for the handful of sellers created before it existed, not written to by new code
  bankAccountHolder String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?
  rejectionReason   String?
  status            VendorStatus @default(PENDING_VERIFICATION)
  rating            Float        @default(0)
  createdAt         DateTime     @default(now())

  // Delivery-eligibility engine inputs (backend/src/modules/logistics) — see plan doc
  // "Phase 2 — Delivery Eligibility Engine". Sellers self-manage these via the existing
  // POST /vendors/product/register self-update endpoint (frontend/seller.html).
  isOpen                Boolean @default(true)  // manual toggle, mirrors ServiceVendor.isOnline
  operatingHoursOpen    String? // "09:00"; null = no time-of-day restriction
  operatingHoursClose   String? // "21:00"
  offersInstantDelivery Boolean @default(false) // opt-in — no fast-delivery promise by default
  offersSameDayDelivery Boolean @default(false)
  processingTimeMinutes Int     @default(30)    // pack/handover time, factored into cutoff math

  // Phase 7 — running totals kept in sync by every ProductLedgerService write path, same
  // discipline as ServiceVendor.totalEarnings/pendingPayout. pendingPayout only reflects
  // what's actually RELEASED from a ProductVendorHold (i.e. withdrawable now) — the settled-
  // but-still-held amount lives in ProductVendorHold.remaining, not here.
  totalEarnings Decimal @default(0) @db.Decimal(12, 2)
  pendingPayout Decimal @default(0) @db.Decimal(12, 2)

  user            User             @relation(fields: [userId], references: [id])
  products        Product[]
  documents       SellerDocument[]
  pickupLocations PickupLocation[]
  aiFeatureUsages AiFeatureUsage[]
  ledgerEntries   ProductVendorLedgerEntry[]
  holds           ProductVendorHold[]
  settlements     ProductVendorSettlement[]

  @@index([city])
}

model SellerDocument {
  id         String   @id @default(cuid())
  vendorId   String
  type       String // GST_CERTIFICATE | PAN_CARD | CANCELLED_CHEQUE | BANK_PASSBOOK | BUSINESS_PROOF | ADDRESS_PROOF | OWNER_PHOTO | OWNER_AADHAAR | WAREHOUSE_IMAGE | STORE_IMAGE | ADDITIONAL
  url        String   @db.Text
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  vendor ProductVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// One seller can have multiple pickup/warehouse locations, each with its own GPS pin and
// (via IssuedInventory-style per-location stock, built in the next module) its own stock.
// Exactly one location per seller should have isPrimary:true — enforced at the application
// layer (setPrimaryPickupLocation()), not a DB constraint, matching this codebase's existing
// "loose" Prisma-level constraints elsewhere (no partial unique index support needed).
model PickupLocation {
  id               String   @id @default(cuid())
  vendorId         String
  name             String
  contactPerson    String?
  mobile           String?
  alternateMobile  String?
  address          String
  landmark         String?
  city             String
  state            String
  pincode          String
  latitude         Float
  longitude        Float
  placeId          String?
  formattedAddress String?
  isPrimary        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  vendor         ProductVendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  inventory      LocationInventory[]
  fulfilledItems OrderItem[]

  @@index([vendorId])
  @@index([city])
}

// Per-pickup-location stock for a product — a seller with 3 warehouses can carry a
// different quantity of the same product at each one. Mirrors CityProduct's shape
// (a per-scope override table) but scoped to PickupLocation instead of City.
model LocationInventory {
  id               String   @id @default(cuid())
  pickupLocationId String
  productId        String
  stock            Int      @default(0)
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  pickupLocation PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([pickupLocationId, productId])
  @@index([pickupLocationId])
  @@index([productId])
}

// ─── Seller Registration (public application, reviewed by admin before a real
// ProductVendor is provisioned) — mirrors PartnerRegistration's proven shape/flow exactly. ───

model SellerRegistration {
  id             String @id @default(cuid())
  registrationId String @unique // SR-YYYYMMDD-XXXX

  // Contact
  phone          String
  alternatePhone String?
  whatsappNumber String?
  email          String?
  userId         String?

  // Business Details
  businessName  String  @default("")
  ownerName     String  @default("")
  businessType  String?
  gstNumber     String?
  panNumber     String?
  aadhaarNumber String?
  cin           String?
  msmeNumber    String?

  // Business Address
  registeredAddress String?
  officeAddress     String?
  warehouseAddress  String?
  city              String?
  state             String?
  pincode           String?

  // Documents (base64 data-URLs or CDN URLs, same pattern as PartnerRegistration)
  gstCertificateUrl   String?  @db.Text
  panCardUrl          String?  @db.Text
  cancelledChequeUrl  String?  @db.Text
  bankPassbookUrl     String?  @db.Text
  businessProofUrl    String?  @db.Text
  addressProofUrl     String?  @db.Text
  ownerPhotoUrl       String?  @db.Text
  ownerAadhaarUrl     String?  @db.Text
  warehouseImages     String[]
  storeImages         String[]
  additionalDocuments String[]

  // Bank Details
  bankAccountHolder String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  // Agreements — one combined acceptance covering Terms, Privacy, Marketplace, Commission,
  // Return, Cancellation and Data Usage policies (named individually in the UI copy).
  agreedTerms Boolean   @default(false)
  agreedAt    DateTime?

  // Meta
  currentStep Int     @default(1)
  status      String  @default("PENDING") // PENDING | APPROVED | REJECTED | HOLD | MORE_INFO
  adminNotes  String?

  pickupLocations SellerRegistrationPickup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model SellerRegistrationPickup {
  id               String  @id @default(cuid())
  registrationId   String
  name             String
  contactPerson    String?
  mobile           String?
  alternateMobile  String?
  address          String
  landmark         String?
  city             String
  state            String
  pincode          String
  latitude         Float
  longitude        Float
  placeId          String?
  formattedAddress String?
  isPrimary        Boolean @default(false)

  registration SellerRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model IssuedInventory {
  id         String    @id @default(cuid())
  vendorId   String
  productId  String
  quantity   Int
  issuedAt   DateTime  @default(now())
  returnedAt DateTime?

  vendor  ServiceVendor @relation(fields: [vendorId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════
// DELIVERY
// ═══════════════════════════════════════════════════════════════════════════

model DeliveryPartner {
  id                 String              @id @default(cuid())
  userId             String              @unique
  type               DeliveryPartnerType
  vehicleType        String?
  vehicleNumber      String?
  baseCity           String
  isAvailable        Boolean             @default(true)
  status             VendorStatus        @default(PENDING_VERIFICATION)
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?
  totalDeliveries    Int                 @default(0)
  rating             Float               @default(0)

  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]
  // Phase 5 — outbound/return product shipments assigned to this rider (separate from the
  // pre-existing `deliveries` above, which back the never-wired-up Delivery model).
  shipments       Shipment[]
  returnShipments ReturnShipment[]
}

model Delivery {
  id                  String         @id @default(cuid())
  partnerId           String
  pickupAddress       String
  pickupLat           Float
  pickupLng           Float
  dropAddress         String
  dropLat             Float
  dropLng             Float
  status              DeliveryStatus
  trackingNumber      String         @unique
  receiverOtp         String?
  receiverOtpVerified Boolean        @default(false)
  proofPhotoUrl       String?
  earningAmount       Decimal        @db.Decimal(10, 2)
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())

  partner DeliveryPartner @relation(fields: [partnerId], references: [id])
  orders  Order[]
}

// ═══════════════════════════════════════════════════════════════════════════
// MASTER ORDERS — the customer-facing order wrapper. One cart / one checkout /
// one payment / one order number for the customer; internally it fans out into
// one or more `Order` rows (child orders, split by category/vendor/seller —
// see the split engine landing in a later phase). Existing `Order` rows and
// every existing order API are untouched — `Order.masterOrderId` is nullable
// so all current single-order flows keep working exactly as before with a
// null master reference; only new checkouts populate it.
// ═══════════════════════════════════════════════════════════════════════════

enum MasterOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

model MasterOrder {
  id                String  @id @default(cuid())
  masterOrderNumber String  @unique // customer-facing, e.g. RM250724001
  customerId        String
  addressId         String?

  // Address snapshot at the moment of booking — addressId above is a live FK that
  // follows whatever the customer's saved Address row says *today*; these columns
  // are copied once at checkout and never touched again, so editing a saved address
  // later can't rewrite where a past order says it was delivered/serviced.
  snapshotAddressLine String?
  snapshotLandmark    String?
  snapshotCity        String?
  snapshotState       String?
  snapshotPincode     String?
  snapshotLatitude    Float?
  snapshotLongitude   Float?
  snapshotGpsAt       DateTime?

  channel       BookingChannel      @default(WEBSITE)
  status        MasterOrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod OrderPaymentMethod?
  paymentId     String?

  // Pricing — authoritative totals the customer actually pays once against.
  // Child Orders carry their own allocated share once the split engine exists.
  grossServiceAmount Decimal @default(0) @db.Decimal(10, 2)
  grossProductAmount Decimal @default(0) @db.Decimal(10, 2)
  subtotal           Decimal @default(0) @db.Decimal(10, 2)
  couponCode         String?
  couponDiscount     Decimal @default(0) @db.Decimal(10, 2)
  membershipDiscount Decimal @default(0) @db.Decimal(10, 2)
  walletUsed         Decimal @default(0) @db.Decimal(10, 2)
  gstAmount          Decimal @default(0) @db.Decimal(10, 2)
  // Booking-time platform/convenience fee — distinct from Invoice.bookingFee (the
  // Remont-page GST invoice breakdown, computed later); this is the raw fee saved
  // at booking creation per the payment-workflow spec's "Platform Charges" field.
  platformCharges    Decimal @default(0) @db.Decimal(10, 2)
  // Phase 4 — sum of each product group's delivery-eligibility charge (backend/src/modules/
  // logistics), added into totalAmount the same way gstAmount is. Unlike gstAmount/discount/
  // wallet, this is never split via allocateAcrossGroups() — each child Order already knows
  // its own delivery charge directly (see Order.deliveryCharge), computed once per group.
  deliveryCharge     Decimal @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal @default(0) @db.Decimal(10, 2)

  // Guest/walk-in customer info (when checking out without an account)
  guestName  String?
  guestPhone String?
  guestEmail String?

  // Optional GST invoice details for business customers — purely informational,
  // printed on the invoice; does not affect pricing/tax calculation.
  customerGstin   String?
  customerGstName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    User     @relation(fields: [customerId], references: [id])
  address     Address? @relation(fields: [addressId], references: [id])
  childOrders Order[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════════════════════════════════════

model Order {
  id                String  @id @default(cuid())
  orderNumber       String  @unique
  masterOrderId     String?
  customerId        String
  vendorId          String?
  serviceId         String?
  addressId         String?
  deliveryId        String?
  amcSubscriptionId String?
  // Set by ShipmentService.createShipmentForOrder() (backend/src/modules/logistics) right
  // after checkout — informational only in this phase: deliveryCharge is recorded, never
  // added to MasterOrder.totalAmount/the Razorpay amount (same restraint as the existing,
  // still-unbilled platformCharges field below).
  deliveryTier      DeliveryTier?
  deliveryCharge    Decimal?      @db.Decimal(10, 2)

  // Phase 5 — seller-side product-order fulfillment stage (see ProductFulfillmentStage doc
  // comment for why this is a side field, not a new OrderStatus value). Null for SERVICE
  // orders and for every order created before this field existed.
  productFulfillmentStage ProductFulfillmentStage?
  productFulfillmentAt   DateTime?
  sellerRejectionReason   String?
  // Set on a new, zero-value Order created by ReturnsService.createReplacementOrder() —
  // loose id (not a Prisma relation) to avoid a self-relation cycle, same convention as
  // commissionRuleId elsewhere in this model.
  replacementOfOrderId   String?

  // Address snapshot at the moment of booking — see the matching fields on
  // MasterOrder for why: addressId is a live FK, these are copied once and frozen.
  snapshotAddressLine String?
  snapshotLandmark    String?
  snapshotCity        String?
  snapshotState       String?
  snapshotPincode     String?
  snapshotLatitude    Float?
  snapshotLongitude   Float?
  snapshotGpsAt       DateTime?

  type          OrderType
  channel       BookingChannel      @default(WEBSITE)
  status        OrderStatus         @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod OrderPaymentMethod?
  paymentId     String?

  // Billing/GST classification — set once at order confirmation (see
  // resolveBillingTransactionType() in common/index.ts) and frozen, same snapshot
  // philosophy as commissionRuleId/Label below. Nullable so existing historical orders
  // are left alone; only orders confirmed after this field's introduction get it set.
  billingTransactionType BillingTransactionType?

  // Pricing breakdown
  serviceAmount       Decimal @default(0) @db.Decimal(10, 2)
  productsAmount      Decimal @default(0) @db.Decimal(10, 2)
  // Phase 8 — sum of OrderItem.taxableValue across this order's PRODUCT items (the ex-GST
  // base seller settlement is computed against — see ProductLedgerService.
  // settleProductOrder()). Null for SERVICE orders and for orders created before this
  // field existed; both fall back to `productsAmount`, which is numerically identical to
  // the taxable base for any GST-Excluded (or 0%) order — i.e. every order that could
  // exist before this feature shipped.
  productsTaxableAmount Decimal? @db.Decimal(10, 2)
  extraWorkAmount     Decimal @default(0) @db.Decimal(10, 2)
  subtotal            Decimal @default(0) @db.Decimal(10, 2)
  couponCode          String?
  couponDiscount      Decimal @default(0) @db.Decimal(10, 2)
  membershipDiscount  Decimal @default(0) @db.Decimal(10, 2)
  walletUsed          Decimal @default(0) @db.Decimal(10, 2)
  gstAmount           Decimal @default(0) @db.Decimal(10, 2)
  platformCharges     Decimal @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal @default(0) @db.Decimal(10, 2)
  remontCommission    Decimal @default(0) @db.Decimal(10, 2)
  vendorPayout        Decimal @default(0) @db.Decimal(10, 2)
  // Which CommissionRule (if any) produced remontCommission above, snapshotted once at
  // confirmation time (Task 9) — never re-derived later, so editing/deleting the rule
  // afterward can't silently change what a past invoice/earnings statement shows.
  // commissionRuleId is deliberately NOT a foreign key (the rule may be deleted later;
  // the label alone must remain readable regardless).
  commissionRuleId    String?
  commissionRuleLabel String?

  // Phase 7 — full snapshot of every marketplace-fee line applied to a PRODUCT order (the
  // commission component above is reused as-is for the COMMISSION line; this JSON carries
  // everything else). Written incrementally: commission/marketing/gateway/gstOnFees
  // resolved+written at checkout (MasterOrdersService.checkout()); `delivery` merged in once
  // Shipment.actualDeliveryCost is known, at settlement time (ProductLedgerService.
  // settleProductOrder()). JSON rather than more scalar columns so it absorbs new
  // ProductFeeType values without another migration — same "evolvable per-row detail" idiom
  // as CommissionRule.slabJson/Product.specifications elsewhere in this schema. Null for
  // every SERVICE order, and for a PRODUCT order before checkout pricing runs.
  // Shape: { commission:{amount,ruleId,ruleLabel}, marketing:{amount,ruleId,ruleLabel},
  //          gateway:{amount,ruleId,ruleLabel}, gstOnFees:{amount,ratePercent},
  //          delivery:{amount,logisticsProviderId,providerName} }
  productFeeBreakdown Json?

  // Vendor Wallet: Lead Cost — deducted from the vendor's ledger the moment they accept this
  // job (see ServiceVendorsService.acceptJob), trued up against remontCommission at
  // completion. Stamped with what was ACTUALLY charged at accept time (independent of
  // whatever the SiteSetting default is later) so the completion true-up and any
  // cancellation refund are always computed against the real historical charge.
  leadCostAmount   Decimal @default(0) @db.Decimal(12, 2)
  leadCostRefunded Boolean @default(false)

  // Service assignment routing (Task 8) — set once by resolveServiceRouting() when the
  // order is confirmed. A flag + free-text outcome rather than a new OrderStatus value,
  // so the existing OrderStatus-based logic elsewhere (dispatch, admin filters, payment
  // flow) needs no changes at all. needsAdminReview drives the admin queue filter;
  // routingDecision is just the human-readable "Routed to: ..." display value.
  needsAdminReview Boolean @default(false)
  routingDecision  String? // ADMIN_TEAM | PROJECT | IN_HOUSE | PARTNER | MANUAL_FALLBACK

  // Vendor auto-dispatch tracking — incremented every time DispatchService.dispatch()
  // rings a wave of candidate vendors for this order. Lets the admin "stuck orders" queue
  // (vendorId null + status CONFIRMED + dispatchAttempts >= 1) find orders nobody has
  // accepted yet, and lets DispatchRetryService find orders whose last wave is stale
  // enough (lastDispatchedAt) to re-dispatch a fresh cycle.
  dispatchAttempts Int       @default(0)
  lastDispatchedAt DateTime?

  // Job lifecycle
  slotStart          DateTime?
  slotEnd            DateTime?
  startOtp           String?
  startOtpVerified   Boolean   @default(false)
  endOtp             String?
  endOtpVerified     Boolean   @default(false)
  // Last time each OTP was (re)sent — drives the 30-60s resend cooldown, same
  // pattern as the existing login-OTP User.otpLastSentAt below.
  startOtpLastSentAt DateTime?
  endOtpLastSentAt   DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  // Set when OrdersService.autoGenerateInvoice() (fire-and-forget on job completion) throws —
  // previously that failure was only ever logged, leaving the order stuck COMPLETED with no
  // invoice forever and nothing admin-visible. InvoicesService.generateForOrder() is already
  // idempotent (returns the existing Invoice if one exists), so admin re-triggering it via
  // the existing POST /admin/invoices/:orderId/generate can never create a duplicate — these
  // two fields just make the failure findable instead of silent, and get cleared the moment
  // generation succeeds (auto-retry or manual).
  invoiceGenerationFailed Boolean @default(false)
  invoiceGenerationError  String?

  // Proof artifacts
  photosBefore String[]
  photosAfter  String[]
  videoUrl     String?

  // Guest/walk-in customer info (when booking without account)
  guestName  String?
  guestPhone String?
  guestEmail String?

  // Admin management
  adminNotes   String?
  internalNote String?

  // CRM/AI tracking
  aiSessionId String?
  leadId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        User             @relation(fields: [customerId], references: [id])
  masterOrder     MasterOrder?     @relation(fields: [masterOrderId], references: [id])
  vendor          ServiceVendor?   @relation(fields: [vendorId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id])
  address         Address?         @relation(fields: [addressId], references: [id])
  delivery        Delivery?        @relation(fields: [deliveryId], references: [id])
  amcSubscription AmcSubscription? @relation(fields: [amcSubscriptionId], references: [id])
  shipment        Shipment?
  items           OrderItem[]
  serviceItems    OrderServiceItem[]
  extraWorkItems  ExtraWorkItem[]
  invoice         Invoice?
  reviews         Review[]
  lead            Lead?            @relation(fields: [leadId], references: [id])
  timeline        OrderTimeline[]
  otpLogs         OrderOtpLog[]
  partnerHolds    PartnerHold[]
  returnShipments ReturnShipment[]
  warrantyCases   WarrantyCase[]
  productVendorLedgerEntries ProductVendorLedgerEntry[]
  productVendorHolds         ProductVendorHold[]

  @@index([customerId])
  @@index([masterOrderId])
  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// Phase 3 — provider-agnostic shipment record, created post-checkout by
// ShipmentService.createShipmentForOrder() (backend/src/modules/logistics). Separate from
// Delivery (own-rider fulfillment, required non-null partnerId) — see plan doc "Phase 3 —
// Shipment Lifecycle" for why reusing Delivery wasn't appropriate here.
model Shipment {
  id                String           @id @default(cuid())
  orderId           String           @unique
  provider          ShipmentProvider
  providerRef       String // e.g. "DEMO-8f2a1c" now; a real AWB/tracking# once a real provider adapter exists
  tier              DeliveryTier
  status            ShipmentStatus   @default(CREATED)
  isDemo            Boolean          @default(true) // unmissable "not a real courier" flag — schema, API, and UI all surface this
  estimatedDelivery DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Phase 5 — rider assignment. Best-effort/nullable: a shipment can still exist with no
  // rider available yet, matching the existing "always succeeds" mock-provider behaviour.
  deliveryPartnerId String?
  partnerAssignedAt DateTime?
  partnerNotes      String?

  // Phase 5 — COD collection/settlement ladder. NOT_APPLICABLE for prepaid (ONLINE) orders,
  // set once at creation and never transitioned. See CodSettlementStatus doc comment.
  codAmount           Decimal?             @db.Decimal(10, 2)
  codSettlementStatus CodSettlementStatus  @default(NOT_APPLICABLE)
  codCollectedAt      DateTime?
  codCollectedBy      String? // DeliveryPartner.id
  codHandedOverAt     DateTime?
  codSettledAt        DateTime?
  codSettledBy        String? // admin userId
  codReconciledAt     DateTime?
  codReconciledBy     String? // admin userId

  // Phase 5 — customer hands this to the rider to confirm real-world delivery, same
  // customer-present idiom as the pre-existing Delivery.receiverOtp.
  deliveryOtp         String?
  deliveryOtpVerified Boolean   @default(false)
  deliveredAt         DateTime?

  // Phase 7 — cost-accounting reference only, snapshotted once at shipment creation from
  // the cheapest active LogisticsProvider (see LogisticsService.pickCostReferenceProvider).
  // Never changes which adapter actually fulfills the shipment (still MOCK_DEMO via
  // `provider` above) — this exists purely so ProductLedgerService.settleProductOrder() has
  // a real delivery-cost figure to deduct on the seller's settlement ledger. Null when no
  // LogisticsProvider row is configured — never fabricate a cost.
  logisticsProviderId String?
  actualDeliveryCost  Decimal? @db.Decimal(10, 2)

  order             Order              @relation(fields: [orderId], references: [id])
  deliveryPartner   DeliveryPartner?   @relation(fields: [deliveryPartnerId], references: [id])
  logisticsProvider LogisticsProvider? @relation(fields: [logisticsProviderId], references: [id])

  @@index([deliveryPartnerId])
  @@index([logisticsProviderId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)
  // Which of the seller's pickup locations fulfills this line item — resolved automatically
  // at order-creation time by distance + stock (see resolvePickupLocation() in
  // products.module.ts). Nullable: products with no LocationInventory rows yet (i.e. every
  // product that existed before this module, or any admin-owned product with no seller
  // pickup locations) simply don't get one — this is additive tracking, never a hard gate
  // on checkout.
  pickupLocationId String?
  // Denormalized Product.vendorId, set once at split-time by the Child Order Engine so
  // seller order queries and the split engine don't have to join through Product every
  // time. Nullable for items created before this field existed.
  vendorId         String?

  // Phase 8 — GST treatment snapshot, resolved once at order-creation time via
  // resolveProductGstLine(), never recomputed later — a later TaxConfig/Product change
  // can't retroactively alter what a past order shows. Null on every pre-existing row and
  // on any order predating this feature; downstream readers must treat null as "legacy
  // line, exclusive-of-tax by implicit convention" (matches historical checkout behavior).
  gstInclusive   Boolean?
  gstRatePercent Decimal? @db.Decimal(5, 2)
  taxableValue   Decimal? @db.Decimal(10, 2)
  gstAmount      Decimal? @db.Decimal(10, 2)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  pickupLocation PickupLocation? @relation(fields: [pickupLocationId], references: [id])

  @@index([orderId])
  @@index([pickupLocationId])
  @@index([vendorId])
}

// One line item per distinct service inside a service-type Order — lets the Child Order
// Engine (MasterOrdersService.checkout) group every service from the same category, same
// address, same checkout into ONE Order instead of one Order per service. Order.serviceId
// stays populated with the first/primary service for backward compatibility with every
// existing single-service read path (order.service.name, routing, dispatch); this table is
// the source of truth for the full per-service breakdown (name via the relation, price,
// quantity) whenever an Order groups more than one service. Purely additive: orders created
// before this table existed simply have zero rows here, and callers fall back to
// Order.service in that case.
model OrderServiceItem {
  id         String  @id @default(cuid())
  orderId    String
  serviceId  String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
}

// Append-only status-change log per Order — not the general event-driven architecture
// (explicitly deferred); just a plain audit trail written directly by order-lifecycle code
// via the writeOrderTimeline() helper in common/index.ts, no event bus involved.
model OrderTimeline {
  id        String    @id @default(cuid())
  orderId   String
  status    String
  note      String?
  actorId   String?
  actorRole UserRole?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Append-only audit trail for job start/completion OTPs — one row per generation
// (initial, at booking) or regeneration ("Request OTP Again"), plus one row when an
// OTP is actually verified/used. Mirrors OrderTimeline's append-only pattern; written
// via the writeOtpLog() helper in common/index.ts. The row for the currently-valid
// OTP is simply the most recent GENERATED/REGENERATED row for that (orderId, otpType) —
// nothing here is ever mutated, so history stays exact even across regenerations.
model OrderOtpLog {
  id              String   @id @default(cuid())
  orderId         String
  otpType         String // START | END
  otp             String
  action          String // GENERATED | REGENERATED | VERIFIED
  requestedByRole String? // VENDOR | SYSTEM | ADMIN — who caused this row
  requestedById   String? // vendorId (or userId) of the requester; null for the initial auto-generation
  createdAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, otpType])
}

model ExtraWorkItem {
  id               String    @id @default(cuid())
  orderId          String
  description      String
  amount           Decimal   @db.Decimal(10, 2)
  addedBy          String
  customerApproved Boolean   @default(false)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  otp              String?
  otpVerified      Boolean   @default(false)
  otpLastSentAt    DateTime?

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor ServiceVendor @relation(fields: [addedBy], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════
// INVOICES & PAYMENTS
// ═══════════════════════════════════════════════════════════════════════════

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  orderId       String @unique

  // Page 1 (Customer)
  customerSubtotal Decimal @db.Decimal(10, 2)
  customerCgst     Decimal @db.Decimal(10, 2)
  customerSgst     Decimal @db.Decimal(10, 2)
  customerTotal    Decimal @db.Decimal(10, 2)

  // Page 2 (Vendor)
  vendorLabor    Decimal @db.Decimal(10, 2)
  vendorMaterial Decimal @db.Decimal(10, 2)
  vendorCgst     Decimal @db.Decimal(10, 2)
  vendorSgst     Decimal @db.Decimal(10, 2)
  vendorTotal    Decimal @db.Decimal(10, 2)

  // Page 3 (Remont)
  platformCommission Decimal @db.Decimal(10, 2)
  bookingFee         Decimal @db.Decimal(10, 2)
  remontCgst         Decimal @db.Decimal(10, 2)
  remontSgst         Decimal @db.Decimal(10, 2)
  remontTotal        Decimal @db.Decimal(10, 2)

  // ─── Billing engine additions (see backend/src/common/billing-engine.ts) ───────────
  // Which revenue model this invoice belongs to, and who the actual invoicing entity is
  // for it — Remont for Type 1/2, or the seller for a Type 3 product invoice. Nullable:
  // historical Invoice rows created before this field existed are left alone (they were
  // always Remont-as-supplier, intra-state, under the old hardcoded math) and are never
  // retroactively rewritten; only invoices generated going forward populate these.
  transactionType BillingTransactionType?
  placeOfSupply   String?
  supplierState   String?
  supplierGstin   String?

  // IGST variants — the pre-existing Cgst/Sgst fields above only ever covered intra-state.
  // Exactly one of (customerCgst+customerSgst) or customerIgst is non-zero per invoice,
  // same for the Remont-page pair; never both, decided by supplierState vs placeOfSupply.
  customerIgst Decimal @default(0) @db.Decimal(10, 2)
  remontIgst   Decimal @default(0) @db.Decimal(10, 2)

  // Visible, stored round-off applied to reconcile the summed line/tax amounts to the
  // displayed total — never silently absorbed into another field.
  roundOff Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)

  // Frozen itemized line detail for the PDF table — {description, hsnSac, qty, unit,
  // rate, discount, taxRate, taxableValue, cgst, sgst, igst, amount}[]. A JSON snapshot
  // rather than a new relational table: Service/Product names and prices can change
  // after the fact, but an issued invoice's line items must never silently drift, and
  // OrderServiceItem/OrderItem/ExtraWorkItem already carry the qty/rate/amount this is
  // built from at generation time.
  lineItemsSnapshot Json?

  pdfUrlPage1    String?
  pdfUrlPage2    String?
  pdfUrlPage3    String?
  pdfUrlCombined String?
  generatedAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model PaymentTransaction {
  id                String                 @id @default(cuid())
  orderId           String?
  masterOrderId     String?
  amcSubscriptionId String?
  userId            String
  amount            Decimal                @db.Decimal(10, 2)
  status            PaymentStatus
  gateway           String                 @default("RAZORPAY")
  gatewayPaymentId  String?
  gatewayOrderId    String?
  gatewaySignature  String?
  // Raw webhook/callback payload — parsed in-memory today (PaymentsService.handleWebhook)
  // but never persisted; kept for audit/dispute resolution.
  gatewayResponse   Json?
  failureReason     String?
  // True for wallet top-ups instead of the previous 'WALLET_TOPUP' sentinel stored in
  // orderId (which collided with the fact orderId is sometimes a real Order.id and
  // sometimes a MasterOrder.id) — see the isWalletTopup migration in migration.sql.
  isWalletTopup     Boolean                @default(false)
  // Set when this row IS a refund payout (gateway or wallet-credit leg) rather than a
  // regular order/top-up payment.
  refundRequestId   String?
  // Only populated for CASH/UPI/CARD collections made by a partner (COD collection,
  // balance-due collection at completion) — null for gateway-collected ONLINE payments.
  collectionMode    PaymentCollectionMode?
  collectedBy       String?
  collectedLocation String?
  createdAt         DateTime               @default(now())
  // Distinct from `status` on purpose: `status` only reflects the gateway's own payment
  // state and gets written by BOTH the explicit confirm-payment call AND the async webhook —
  // whichever lands first. Using `status==='PAID'` as the "have we already credited the
  // wallet/ledger" signal let a webhook that races ahead of the explicit confirm call mark
  // this PAID without ever crediting anything, and the explicit confirm call would then see
  // PAID and skip crediting too — money captured by Razorpay, never credited to anyone.
  // `creditedAt` is set exactly once, by whichever caller wins the atomic claim
  // (`updateMany` guarded on `creditedAt: null`) right before performing the actual wallet/
  // ledger credit — see WalletService.confirmTopup / WithdrawalService.confirmTopup /
  // PaymentsService.handleWebhook.
  creditedAt        DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([masterOrderId])
  @@index([refundRequestId])
}

// ═══════════════════════════════════════════════════════════════════════════
// REFUNDS & PARTNER SETTLEMENT
// ═══════════════════════════════════════════════════════════════════════════

// Full refund approval pipeline (business rule, highest priority): a refund is NEVER
// automatic, even for online payments. Customer raises a request -> evidence collection
// -> partner gets a chance to respond -> Remont support reviews -> only an ADMIN/SUPER_ADMIN
// can make the final call (approve/reject/partial/convert-to-wallet/free-rework/escalate).
// customerId/orderId/masterOrderId/approvedBy are loose, non-FK string fields — same
// convention already used by PaymentTransaction/WalletTransaction in this schema, so admin
// list/detail queries do their own id-based lookups rather than relying on a Prisma relation.
model RefundRequest {
  id                  String              @id @default(cuid())
  orderId             String?
  masterOrderId       String?
  customerId          String
  reason              String
  evidenceUrls        String[]
  status              RefundRequestStatus @default(REQUESTED)
  partnerId           String?
  partnerResponse     String?
  partnerRespondedAt  DateTime?
  decisionMode        RefundDecisionMode?
  approvedAmount      Decimal?            @db.Decimal(10, 2)
  walletCreditAmount  Decimal?            @db.Decimal(10, 2)
  gatewayRefundAmount Decimal?            @db.Decimal(10, 2)
  gatewayRefundId     String?
  adminNotes          String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  logs RefundRequestLog[]

  @@index([orderId])
  @@index([masterOrderId])
  @@index([customerId])
  @@index([status])
}

// Append-only audit trail — mirrors the existing OrderTimeline/writeOrderTimeline()
// pattern (backend/src/common/index.ts). Nothing is ever deleted or overwritten;
// every state transition (request raised, evidence added, partner responded, admin
// note, approval/rejection, escalation) gets its own row.
model RefundRequestLog {
  id              String    @id @default(cuid())
  refundRequestId String
  actorId         String?
  actorRole       UserRole?
  action          String
  notes           String?
  createdAt       DateTime  @default(now())

  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  @@index([refundRequestId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ORDER HELP & SUPPORT — a structured "select item → select issue → check
// status → check policy → resolve" layer on top of the existing RefundRequest
// pipeline. This module NEVER moves money itself: a resolution that implies a
// refund creates a RefundRequest (refundRequestId below) and drives it through
// RefundsService.raise()/.decide() exactly as a customer-raised refund would —
// see backend/src/modules/support/support.module.ts.
// ═══════════════════════════════════════════════════════════════════════════

enum SupportItemType {
  PRODUCT
  SERVICE
}

enum SupportIssueType {
  // product
  NOT_DELIVERED
  DELIVERED_LATE
  WRONG_PRODUCT
  DAMAGED_PRODUCT
  MISSING_ITEM
  CANCEL_PRODUCT
  RETURN_PRODUCT
  // Phase 6 — a product-not-working report for a warranty-eligible product, routed to the
  // WarrantyCase workflow instead of a normal return (see SupportPolicyEngine.recommend()).
  WARRANTY_CLAIM
  // service
  PARTNER_NOT_ASSIGNED
  PARTNER_ON_THE_WAY
  PARTNER_ARRIVED
  PARTNER_DID_NOT_ARRIVE
  SERVICE_STARTED_ISSUE
  SERVICE_COMPLETED_ISSUE_NOT_FIXED
  // shared
  OTHER_ISSUE
}

enum SupportCaseStatus {
  OPEN
  IN_REVIEW
  WAITING_CUSTOMER
  WAITING_PARTNER
  DISPUTE
  ADMIN_REVIEW
  RESOLVED
  CLOSED
}

enum SupportResolutionType {
  FULL_REFUND
  PARTIAL_REFUND
  REFUND_MINUS_VISIT
  REFUND_MINUS_DIAGNOSIS
  NO_REFUND
  FREE_REVISIT
  FREE_REWORK
  REASSIGN_PARTNER
  NEW_SERVICE_REQUIRED
  CUSTOMER_PAYABLE
  PARTNER_LIABILITY
  SPLIT_LIABILITY
  // Phase 5 — terminal state for the RETURN_PRODUCT/WRONG_PRODUCT/DAMAGED_PRODUCT/MISSING_ITEM
  // auto-resolution step: a physical pickup is scheduled (see ReturnShipment) instead of an
  // instant refund. NOT in REFUND_RESOLUTIONS — no money moves until seller inspection accepts.
  RETURN_PICKUP_INITIATED
  // Phase 5 — chosen remedy once a return is accepted: a new zero-value replacement Order is
  // created instead of a wallet/gateway refund. See Order.replacementOfOrderId.
  REPLACEMENT
  // Phase 6 — terminal state for the WARRANTY_CLAIM auto-resolution step: opens a WarrantyCase
  // instead of moving money. See WarrantyService.openCase().
  WARRANTY_CLAIM_OPENED
}

// Item-scoped by design — orderId is always ONE Order (one child order for a service, one
// product order for a product), never a whole MasterOrder. orderItemId narrows further to a
// single line item inside a multi-item product Order (see the "item-level scoping" note in
// the implementation plan for why a multi-item product issue is resolved as a partial refund
// against the same Order rather than a status change on OrderItem, which has none today).
model SupportCase {
  id         String @id @default(cuid())
  caseNumber String @unique // customer-facing, e.g. SUP-000123

  orderId     String
  orderItemId String?
  customerId  String
  partnerId   String? // ServiceVendor.id snapshotted at case-open time

  itemType    SupportItemType
  issueType   SupportIssueType
  description String?
  evidenceUrls String[]
  // Phase 5 — customer's preferred remedy for a return-shaped issue, set at openCase() time.
  // Plain string (not a Prisma enum), matching how routeType is already stored here — defaults
  // to REFUND behaviour when unset, so every pre-existing case stays backward compatible.
  requestedRemedy String? // REFUND | REPLACEMENT

  // Order.status frozen at the moment the case was opened — the live order can keep
  // moving forward (e.g. a partner who "did not arrive" might complete the job an hour
  // later); the case record should always reflect what was true when it was raised.
  statusSnapshot String
  status         SupportCaseStatus @default(OPEN)
  // Which branch of the master flow this case took — AUTO_RESOLUTION | SUPPORT_CASE | DISPUTE
  routeType      String

  partnerResponse    String?
  partnerRespondedAt DateTime?

  // System recommendation (section 16) — always computed, never skipped, so admin always
  // has a starting point even when they ultimately override it.
  recommendedResolution SupportResolutionType?
  recommendedAmount     Decimal?               @db.Decimal(10, 2)
  recommendationReason  String?
  policyApplied         String?

  // Final decision — decidedBy is null for a true system auto-resolution.
  resolutionType   SupportResolutionType?
  resolutionAmount Decimal?               @db.Decimal(10, 2)
  resolutionReason String?
  decidedBy        String?
  decidedAt        DateTime?
  refundRequestId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  logs           SupportCaseLog[]
  returnShipment ReturnShipment?
  warrantyCase   WarrantyCase?

  @@index([orderId])
  @@index([customerId])
  @@index([partnerId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// RETURN LOGISTICS (Phase 5) — the physical pickup-from-customer,
// deliver-to-ORIGINAL-seller leg of a return, gated by SupportPolicyEngine's
// RETURN_PICKUP_INITIATED resolution (see backend/src/modules/returns).
// Deliberately a separate model from Shipment (not a `direction` flag on it):
// Shipment.orderId is @unique and read as a to-one relation everywhere
// (ShipmentController, frontend _shipmentBanner()) — relaxing that would
// silently break every existing read site for a feature most orders never
// use. Reuses the existing ShipmentProvider/ShipmentStatus enums since the
// state machine is mechanically identical (created -> picked up -> in
// transit -> delivered), just customer->seller instead of seller->customer.
// ═══════════════════════════════════════════════════════════════════════════
// Phase 6 — RETURN, RTO (return-to-origin, a customer cancellation after the outbound
// shipment has already been picked up), and WARRANTY pickups all share this exact state
// machine (created -> picked up -> in transit -> delivered-to-seller), so they reuse this one
// model via `kind` rather than three parallel tables. `orderId` was never @unique (unlike
// outbound Shipment), so this reuse is free — see the schema comment on Shipment for why a
// separate model existed in the first place.
enum ReturnShipmentKind {
  RETURN
  RTO
  WARRANTY
}

model ReturnShipment {
  id            String   @id @default(cuid())
  orderId       String
  // Phase 6 — nullable: an RTO is triggered directly from a cancellation request with no
  // originating SupportCase; manufacturing a fake one would pollute support-case counts/
  // queues with rows that have no real customer-raised "issue" behind them. @unique on a
  // nullable Postgres column still permits only one row per non-null value, so every
  // pre-existing RETURN row (always non-null) keeps behaving exactly as before.
  supportCaseId String?  @unique
  kind          ReturnShipmentKind @default(RETURN)

  provider    ShipmentProvider @default(MOCK_DEMO)
  providerRef String
  status      ShipmentStatus   @default(CREATED)
  isDemo      Boolean          @default(true)

  // Phase 6 — which LogisticsProvider (cost/eta record) was selected for this reverse-
  // logistics shipment, via ReverseLogisticsRateEngine.pickCheapest(). Null for rows created
  // before this existed. Outbound Shipment has no equivalent column — lowest-cost selection
  // is deliberately scoped to return/RTO/warranty shipments only, never the outbound flow.
  logisticsProviderId String?

  deliveryPartnerId String?
  estimatedPickup   DateTime?

  // Phase 6 — the SELLER's recommendation only; NOT a final decision. Only an admin's call to
  // ReturnsService.finalize()/finalizeRto() actually moves money — see inspectionStatus below,
  // which now represents the admin's final decision, still gated PENDING-until-decided.
  sellerRecommendation      ReturnInspectionStatus?
  sellerRecommendationNotes String?
  sellerRecommendedAt       DateTime?

  // Customer hands this to the rider at pickup — same OTP-present idiom as outbound delivery.
  // No OTP is needed at the "delivered to seller" end; the seller's own inspectReturn()
  // acceptance later serves as that leg's confirming step instead.
  pickupOtp         String?
  pickupOtpVerified Boolean   @default(false)

  // Phase 6 — this is now the ADMIN's final decision (not the seller's — see
  // sellerRecommendation above). inspectedBy is the admin's User.id (or, for the pre-Phase-6
  // seller-decides flow now retired, historically a User.id too — never a ProductVendor.id,
  // matching every other actorId convention in this codebase).
  inspectionStatus ReturnInspectionStatus @default(PENDING)
  inspectionNotes  String?
  inspectedAt      DateTime?
  inspectedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order             Order              @relation(fields: [orderId], references: [id])
  supportCase       SupportCase?       @relation(fields: [supportCaseId], references: [id])
  deliveryPartner   DeliveryPartner?   @relation(fields: [deliveryPartnerId], references: [id])
  logisticsProvider LogisticsProvider? @relation(fields: [logisticsProviderId], references: [id])

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([logisticsProviderId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MULTI-PROVIDER REVERSE LOGISTICS (Phase 6) — an admin-managed directory of
// courier/logistics accounts for RETURN/RTO/WARRANTY shipments specifically.
// Deliberately NOT a ShipmentProviderAdapter (that interface is implemented by
// code, e.g. MockDeliveryProvider, and stays untouched/outbound-only) — this is
// pure config data queried by ReverseLogisticsRateEngine.pickCheapest() to pick
// the lowest-cost eligible option, per the "never default to fastest/express"
// business rule. Not a SiteSetting group either: the requirement is an
// arbitrary, independently-toggleable LIST of provider records, not a single
// settings blob (mirrors why PickupLocation is a real table, not a setting).
// ═══════════════════════════════════════════════════════════════════════════
model LogisticsProvider {
  id          String  @id @default(cuid())
  name        String
  // Which adapter implementation actually executes a shipment on this provider's behalf.
  // Only MOCK_DEMO exists today; every seeded row points at it until a real courier account
  // is connected — the provider directory (cost/priority/enable) is independent of which
  // adapter code eventually fulfills it.
  adapterKey  String  @default("MOCK_DEMO")
  isActive    Boolean @default(true)
  // Lower wins a tie on cost — see pickCheapest()'s ORDER BY baseCost asc, priority asc.
  priority    Int     @default(100)
  supportsCod Boolean @default(false)
  environment String  @default("SANDBOX") // SANDBOX | PRODUCTION

  baseCost Decimal @db.Decimal(10, 2) @default(0)
  etaDays  Int     @default(5)

  // Never returned to any frontend response — AdminService.listLogisticsProviders() omits
  // this field entirely, returning only a `hasCredentials: boolean` derived flag instead.
  credentialsJson       Json?
  serviceableCitiesJson Json? // null = serviceable everywhere (matches Product.coverageType's PAN_INDIA default spirit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  returnShipments ReturnShipment[]
  shipments       Shipment[]

  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// PRODUCT WARRANTY (Phase 6) — brand/manufacturer warranty claims, distinct
// from RefundRequest/ReturnShipment (a normal return/replacement) AND from the
// pre-existing PartnerHold(WARRANTY_HOLD) (a vendor-payout defect-liability
// hold for SERVICE jobs — confirmed zero overlap, unrelated concept). A claim
// always originates from a SupportCase(WARRANTY_CLAIM) — see
// SupportPolicyEngine.recommend() — so evidence reuses SupportCase.evidenceUrls
// rather than a new attachments table.
// ═══════════════════════════════════════════════════════════════════════════
enum WarrantyDecision {
  APPROVED_REPAIR
  APPROVED_REPLACEMENT
  APPROVED_REFUND
  REJECTED
}

enum WarrantyCaseStatus {
  OPEN
  SELLER_REVIEW
  ADMIN_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

model WarrantyCase {
  id         String @id @default(cuid())
  caseNumber String @unique // WAR-000123

  orderId       String
  orderItemId   String?
  productId     String
  customerId    String
  supportCaseId String @unique

  status WarrantyCaseStatus @default(OPEN)

  // Seller's recommendation only — same seller-recommends/admin-decides split as
  // ReturnShipment.sellerRecommendation above.
  sellerRecommendation      WarrantyDecision?
  sellerRecommendationNotes String?
  sellerRecommendedAt       DateTime?

  finalDecision   WarrantyDecision?
  decidedBy       String?
  decidedAt       DateTime?
  resolutionNotes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  order       Order       @relation(fields: [orderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  supportCase SupportCase @relation(fields: [supportCaseId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([status])
}

// Append-only audit trail — same shape/purpose as RefundRequestLog above.
model SupportCaseLog {
  id            String    @id @default(cuid())
  supportCaseId String
  actorId       String?
  actorRole     UserRole?
  action        String
  notes         String?
  createdAt     DateTime  @default(now())

  case SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)

  @@index([supportCaseId])
}

// Manual record-keeping of partner payouts — no payout gateway is configured, so this
// documents that admin already paid the partner outside the platform (bank transfer,
// UPI, cash, cheque) and reduces ServiceVendor.pendingPayout. Replaces the currently
// disconnected frontend/admin/partner-earnings.html screen, which calls endpoints
// that don't exist yet.
model PartnerSettlement {
  id              String         @id @default(cuid())
  vendorId        String
  amount          Decimal        @db.Decimal(12, 2)
  mode            SettlementMode
  referenceNumber String?
  notes           String?
  paidBy          String
  paidAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([paidAt])
}

// ── Phase 2: per-partner ledger — same single-entry-with-running-balance idiom
// as WalletTransaction below, just vendorId-keyed with a richer category enum.
// ServiceVendor.totalEarnings/pendingPayout keep being maintained exactly as
// before (existing admin screens depend on them); this is additive detail.
model PartnerLedgerEntry {
  id                  String          @id @default(cuid())
  vendorId            String
  type                LedgerEntryType
  amount              Decimal         @db.Decimal(12, 2) // signed: + credits the partner, - debits
  balanceAfter        Decimal         @db.Decimal(12, 2)
  orderId             String?
  withdrawalRequestId String?
  notes               String?
  createdBy           String? // admin/agency-owner userId, when manually posted
  createdAt           DateTime        @default(now())

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, createdAt])
}

enum PartnerHoldType {
  WARRANTY_HOLD // % of a completed job's payout, held per ServiceCategory.warrantyDays/warrantyHoldPercent
  ADMIN_MANUAL // ad-hoc hold an admin places on a vendor (e.g. during a fraud/dispute investigation)
}

enum PartnerHoldStatus {
  HELD
  RELEASED
  FORFEITED
}

// Vendor Wallet: the stateful lifecycle a plain ledger transaction log can't represent on
// its own — a hold is created, then later released (auto via cron or admin) or forfeited
// (admin decision, or fully consumed by a refund deducted against it). Every state change
// also posts a HOLD/HOLD_RELEASE entry to PartnerLedgerEntry via PartnerLedgerService, which
// stays the single source of truth for the vendor's actual balance — this table only tracks
// "how much of what's already been debited is still being held and why."
model PartnerHold {
  id           String            @id @default(cuid())
  vendorId     String
  type         PartnerHoldType
  amount       Decimal           @db.Decimal(12, 2) // original held amount
  remaining    Decimal           @db.Decimal(12, 2) // starts == amount; refund-deductions reduce it
  orderId      String? // set for WARRANTY_HOLD
  status       PartnerHoldStatus @default(HELD)
  releaseDueAt DateTime? // WARRANTY_HOLD: completedAt + category warranty days. null = admin-only release (ADMIN_MANUAL)
  releasedAt   DateTime?
  releasedBy   String? // admin userId; null when auto-released by the daily cron sweep
  notes        String?
  createdBy    String? // admin userId for ADMIN_MANUAL; null for system-created WARRANTY_HOLD
  createdAt    DateTime          @default(now())

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([vendorId, status])
  @@index([status, releaseDueAt])
}

// Same proven shape as DeleteRequest (typed status enum + reviewedBy FK + reviewNote)
// rather than PartnerRegistration's looser free-text-status shape.
model WithdrawalRequest {
  id                        String           @id @default(cuid())
  vendorId                  String // always an individual or agency owner — agencyOwnerId must be null, enforced in service layer
  amount                    Decimal          @db.Decimal(12, 2)
  availableBalanceAtRequest Decimal          @db.Decimal(12, 2) // snapshot for audit, same idiom as Order.commissionRuleLabel
  status                    WithdrawalStatus @default(PENDING)
  reviewedBy                String?
  reviewNote                String?
  settlementId              String? // set once PAID — the PartnerSettlement created via the existing SettlementsService.record()
  createdAt                 DateTime         @default(now())
  reviewedAt                DateTime?

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase 7 — PRODUCT-seller marketplace settlement engine. Deliberately a parallel,
// ProductVendor-keyed set of tables rather than reusing PartnerLedgerEntry/PartnerHold/
// PartnerSettlement above — those three are hard-FK'd to ServiceVendor (`vendor
// ServiceVendor @relation`), and weakening that non-null relation to admit a second vendor
// type would risk every existing SERVICE-side ledger query. Same single-entry-running-
// balance idiom, same hold/release lifecycle, same manual-settlement idiom — just mirrored,
// not shared. See ProductLedgerService (backend/src/modules/product-ledger).
// ═══════════════════════════════════════════════════════════════════════════

enum ProductLedgerEntryType {
  GROSS_SALE // + full productsAmount, posted at settlement (delivery)
  COMMISSION // - platform commission, resolved via ProductFeeRule
  GST_ON_FEES // - GST on Remont's own fees, reuses buildTaxRateResolver('PLATFORM_FEE', ...)
  DELIVERY_COST // - Remont's actual outbound delivery cost for this order's shipment
  MARKETING_FEE // - marketing/promotion fee, resolved via ProductFeeRule
  GATEWAY_FEE // - payment gateway fee, resolved via ProductFeeRule
  OTHER_FEE // - any future ProductFeeType(OTHER) fee
  RETURN_ADJUSTMENT // +/- reversal posted when a RETURN is finalized, proportional to refunded amount
  RTO_ADJUSTMENT // +/- reversal posted when an RTO is finalized, proportional to refunded amount
  HOLD // - moved into a ProductVendorHold (return-window hold) at settlement time
  HOLD_RELEASE // + released from a ProductVendorHold once its return window has passed
  PAYOUT // - a ProductVendorSettlement was recorded (money actually paid out)
  ADJUSTMENT // manual admin correction
}

// Exact single-entry-with-running-balance idiom as PartnerLedgerEntry (above).
model ProductVendorLedgerEntry {
  id           String                 @id @default(cuid())
  vendorId     String
  type         ProductLedgerEntryType
  amount       Decimal                @db.Decimal(12, 2) // signed: + credits seller, - debits
  balanceAfter Decimal                @db.Decimal(12, 2)
  orderId      String?
  settlementId String?
  notes        String?
  createdBy    String? // admin userId, when manually posted
  createdAt    DateTime               @default(now())

  vendor ProductVendor @relation(fields: [vendorId], references: [id])
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([vendorId, createdAt])
  @@index([orderId])
}

enum ProductHoldType {
  RETURN_WINDOW_HOLD // the settled net credit for one order, held until its product's return window passes
  ADMIN_MANUAL // ad-hoc hold an admin places on a seller
}

enum ProductHoldStatus {
  HELD
  RELEASED
  FORFEITED
}

// Mirrors PartnerHold (above) exactly — a settled order's net credit is held here (and
// debited from the live ledger as a HOLD entry) until releaseDueAt passes, then a daily
// cron (ProductHoldSweepService, same slot as WarrantyHoldSweepService) posts HOLD_RELEASE
// and moves it into ProductVendor.pendingPayout. A return/RTO that lands while still HELD
// deducts from `remaining` first, exactly like PartnerLedgerService.deductFromHold().
model ProductVendorHold {
  id           String            @id @default(cuid())
  vendorId     String
  type         ProductHoldType
  amount       Decimal           @db.Decimal(12, 2)
  remaining    Decimal           @db.Decimal(12, 2)
  orderId      String? // set for RETURN_WINDOW_HOLD
  status       ProductHoldStatus @default(HELD)
  releaseDueAt DateTime? // deliveredAt + product.returnWindowDays (falls back to SiteSetting support_product_return_window_days). null = admin-only release (ADMIN_MANUAL)
  releasedAt   DateTime?
  releasedBy   String? // admin userId; null when auto-released by the daily cron sweep
  notes        String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  vendor ProductVendor @relation(fields: [vendorId], references: [id])
  order  Order?        @relation(fields: [orderId], references: [id])

  @@index([vendorId, status])
  @@index([status, releaseDueAt])
}

// Mirrors PartnerSettlement (above) — manual admin-recorded payout, reuses SettlementMode.
model ProductVendorSettlement {
  id              String         @id @default(cuid())
  vendorId        String
  amount          Decimal        @db.Decimal(12, 2)
  mode            SettlementMode
  referenceNumber String?
  notes           String?
  paidBy          String
  paidAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())

  vendor ProductVendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([paidAt])
}

// Minimal daily check-in/out — nothing to extend, no attendance concept existed before.
model VendorAttendance {
  id         String    @id @default(cuid())
  vendorId   String
  date       DateTime  @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  checkInLat Float?
  checkInLng Float?

  vendor ServiceVendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, date])
}

