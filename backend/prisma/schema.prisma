// ─── Partner Registration (pre-approval onboarding) ───────────────────────────
model PartnerRegistration {
  id             String @id @default(cuid())
  registrationId String @unique // PR-YYYYMMDD-XXXX

  // Contact
  phone  String
  userId String?

  // Step 2 — Basic Info
  fullName    String  @default("")
  email       String?
  gender      String?
  dateOfBirth String?

  // Address
  fullAddress    String?
  city           String?
  area           String?
  state          String?
  pincode        String?
  latitude       Float?
  longitude      Float?
  locationSource String?

  // Step 3 — Service Categories
  categories    String[]
  categoryOther String?

  // Step 4 — Experience
  experienceYears    String?
  previousCompany    String?
  hasOwnTeam         Boolean @default(false)
  teamSize           Int?
  hasOwnVehicle      Boolean @default(false)
  availableFullTime  Boolean @default(false)
  availableEmergency Boolean @default(false)

  // Step 5 — Documents (base64 data-URLs or CDN URLs)
  idProofType              String?
  idProofFront             String? @db.Text
  idProofBack              String? @db.Text
  panNumber                String?
  panCardUrl               String? @db.Text
  profilePhotoUrl          String? @db.Text
  skillCertificateUrl      String? @db.Text
  policeVerificationUrl    String? @db.Text
  policeVerificationStatus String? // AVAILABLE | NEED_HELP

  // Step 6 — Bank Details
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankName           String?
  bankBranch         String?
  upiId              String?
  cancelledChequeUrl String? @db.Text

  // Step 7 — Emergency Contact
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  emergencyAltPhone String?

  // Step 8 — Agreements
  agreedTerms      Boolean   @default(false)
  agreedBackground Boolean   @default(false)
  agreedCommission Boolean   @default(false)
  agreedStandards  Boolean   @default(false)
  agreedAt         DateTime?

  // Meta
  language    String  @default("EN")
  currentStep Int     @default(1)
  status      String  @default("PENDING") // PENDING | APPROVED | REJECTED | HOLD | MORE_DOCS
  adminNotes  String?

  // Phase 2 — set when an agency owner invites this person as a team member;
  // _activatePartner() reads this to set the new ServiceVendor's agencyOwnerId.
  invitedByAgencyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model DeleteRequest {
  id          String              @id @default(cuid())
  targetType  DeleteTargetType
  targetId    String
  targetLabel String
  reason      String?
  requestedBy String
  requester   User                @relation("DeleteRequester", fields: [requestedBy], references: [id])
  status      DeleteRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewer    User?               @relation("DeleteReviewer", fields: [reviewedBy], references: [id])
  reviewNote  String?
  createdAt   DateTime            @default(now())
