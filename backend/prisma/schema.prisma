// How a payment (order balance, COD collection, or refund payout) was actually
// moved — distinct from `PaymentTransaction.gateway` (which gateway, e.g. RAZORPAY)
// since CASH/UPI/CARD collections never touch a gateway at all.
enum PaymentCollectionMode {
  ONLINE
  CASH
  UPI
  CARD
  WALLET
}

// Persisted at booking time on Order/MasterOrder — previously only traveled as a
