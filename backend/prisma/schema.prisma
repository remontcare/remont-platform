enum GstPriceType {
  GST_INCLUSIVE
  GST_EXCLUSIVE
}

model TaxConfig {
  id        String   @id @default(cuid())
  name      String // e.g. "GST 18%"
  type      String   @default("GST") // GST, SERVICE_TAX, CESS
  rate      Decimal  @db.Decimal(5, 2)
  hsnCode   String? // HSN/SAC code
  appliesTo String[] // SERVICE, PRODUCT, AMC, PLATFORM_FEE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Phase 8 — distinct from rate=0: real GST law separates NIL-rated (0%, still
  // "applicable") from exempt (not applicable at all). buildTaxRateResolver() forces
  // rateFor() to 0 whenever the matched row has this false, regardless of `rate`.
  gstApplicable Boolean @default(true)
  // Whether `rate` is baked into the product's quoted price (MRP-style, e.g. ₹1,180
  // inclusive of 18%) or added on top at checkout (₹1,000 + 18%). Default EXCLUSIVE
  // preserves every existing row's implicit behavior with zero backfill needed.
  priceType GstPriceType @default(GST_EXCLUSIVE)
  // Category-level default — appliesTo is scope-type only (SERVICE/PRODUCT/...), so
  // there was previously no way to default GST per ProductCategory; null = this row is
  // a blanket/HSN-generic default for `appliesTo`, exactly as before.
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  // Effective-dating — mirrors CommissionRule/ProductFeeRule's validFrom/validTo idiom
  // exactly. No @@unique on (appliesTo,hsnCode)/(appliesTo,productCategoryId): that would
  // break versioning by forbidding two rows with non-overlapping date windows for the
  // same scope, which is the entire point of this field. Overlap conflicts are instead
  // caught by application-level validation at write time (AdminService.createTaxConfig/
  // updateTaxConfig, and reused by the ProductFeeRule bulk-import's conflict detection).
  validFrom DateTime?
  validTo   DateTime?

  updatedAt DateTime @default(now()) @updatedAt

  @@index([appliesTo, hsnCode, isActive])
  @@index([appliesTo, productCategoryId, isActive])
}

