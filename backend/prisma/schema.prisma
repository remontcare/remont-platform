// Phase 5 — seller-side product-order fulfillment stage, tracked as a side field on Order
// rather than a new OrderStatus value. OrderStatus is shared with SERVICE orders and has
// several exhaustive-ish switches over it elsewhere (SupportPolicyEngine.deriveServiceStage,
// AdminController.adminUpdateStatus's hardcoded validStatuses array, seller.html's
// orderBucket()) — widening it risks silently breaking one of those. Mirrors the existing
// Order.needsAdminReview/routingDecision side-flag pattern. Null for SERVICE orders; Order.status
// itself stays CONFIRMED for a product order through this whole window, exactly as before.
enum ProductFulfillmentStage {
  AWAITING_SELLER
  SELLER_ACCEPTED
  SELLER_REJECTED
  PROCESSING
  READY_FOR_PICKUP
  HANDED_TO_LOGISTICS
}

// Phase 5 — COD settlement ladder for a product Shipment. Deliberately NOT modeled on
// ServiceVendor.pendingPayout/PartnerLedgerEntry: that system is vendor-collects-directly
// money; product COD is logistics-provider-collects-on-Remont's-behalf money — a different
// flow. See Shipment.codSettlementStatus.
enum CodSettlementStatus {
  NOT_APPLICABLE
  COD_EXPECTED
  COD_COLLECTED
  COD_SETTLEMENT_PENDING
  COD_SETTLED
  COD_RECONCILED
}

// Phase 5 — outcome of a seller physically inspecting a returned item, see ReturnShipment.
enum ReturnInspectionStatus {
