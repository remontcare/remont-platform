}

// Which pipeline a service's orders route through when confirmed — see
// resolveServiceRouting() in common/index.ts.
enum FulfillmentType {
  DIRECT_PARTNER // auto-match a vendor (in-house first, then partner) — current default behaviour
  ADMIN_TEAM // smaller admin-handled services — no auto vendor match, goes to the admin queue
  PROJECT // project-scale work — never auto-assigned, always goes to the admin queue
}

// In-house Remont staff vs an external partner vendor — used to prioritize in-house
// staff first when auto-routing a DIRECT_PARTNER service.
enum StaffType {
