model Lead {
  id             String  @id @default(cuid())
  // Customer details (may not be a registered user yet)
  customerName   String
  customerPhone  String
  customerEmail  String?
  customerUserId String? // linked once converted to registered user
  cityName       String?

  // Lead source & status
  source            LeadSource
  status            LeadStatus @default(NEW)
  serviceInterested String?
  estimatedValue    Decimal?   @db.Decimal(10, 2)

  // Tracking
  assignedAgentId  String?
  notes            String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  convertedAt      DateTime?
  convertedOrderId String?
  lostReason       String?

  // Source tracking
  aiSessionId String?
  utmSource   String?
  utmCampaign String?
  utmMedium   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User?         @relation("LeadCustomer", fields: [customerUserId], references: [id])
  agent      User?         @relation("LeadAgent", fields: [assignedAgentId], references: [id])
  activities CrmActivity[]
  orders     Order[]

  @@index([status])
  @@index([assignedAgentId])
  @@index([customerPhone])
  @@index([createdAt])
}

model CrmActivity {
  id          String    @id @default(cuid())
  leadId      String
  agentId     String
  type        String // CALL, WHATSAPP, EMAIL, MEETING, NOTE
  notes       String
  outcome     String?
  nextAction  String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())

  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent User @relation(fields: [agentId], references: [id])

  @@index([leadId, createdAt])
}

