# ─── App ───
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ───
DATABASE_URL="postgresql://postgres:password@localhost:5432/remont_india?schema=public"

# ─── Redis (real-time + caching) ───
REDIS_URL=redis://localhost:6379

# ─── JWT ───
# JWT_EXPIRES_IN can now be shortened (e.g. 1h-2h) for tighter session timeouts —
# the frontend's shared auth client (frontend/shared/remont-auth.js) transparently
# calls /auth/refresh on a 401, so a short-lived access token no longer means
# users get logged out; the refresh token (below) carries the real session length.
JWT_SECRET=replace-with-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Dev-only OTP bypass (never set in production) ───
DEV_OTP_OVERRIDE=

# ─── SMS/WhatsApp (MSG91) ───
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=your-template-id
MSG91_SENDER_ID=RMNTIN

# ─── Razorpay ───
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Cloudinary (image storage) ───
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── AI Provider (when LLM swap-in) ───
AI_PROVIDER=RULE_BASED
# Or: OPENAI / ANTHROPIC
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ─── Admin defaults ───
ADMIN_DEFAULT_PHONE=+919876543210
ADMIN_DEFAULT_EMAIL=admin@remontindia.com

# ─── Webhooks for CRM integrations ───
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Notification Engine (Firebase Cloud Messaging) ───
# All three must be set together for push to go live — the engine runs in a
# safe no-op/logged-only mode (mirrors the MSG91/Razorpay "not configured" pattern
# above) until then, so it's safe to deploy before these exist.
# FIREBASE_PRIVATE_KEY: paste the service-account JSON's "private_key" value with
# literal \n line breaks kept intact (most hosts need it wrapped in quotes).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Public VAPID key for Web Push (Firebase Console → Cloud Messaging → Web configuration).
# Safe to expose client-side — read by frontend/shared/remont-notifications.js.
FIREBASE_VAPID_KEY=
# Public web SDK config (also not secret — same object Firebase Console shows you
# when registering a Web app). Used by remont-notifications.js to init the SDK.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
